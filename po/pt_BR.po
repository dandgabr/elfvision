msgid "Using credentials from %s in read-only mode."
msgstr "Usando as credenciais de %s em modo somente leitura."

#: lib/prefs/accountText.js:12
msgid "No usable credential was found. Sign in to %s, then check again."
msgstr "Nenhuma credencial utilizável foi encontrada. Entre em %s e consulte novamente."

#: lib/prefs/accountText.js:14
msgid ""
"The credential was rejected or expired. Open %s so it can renew, then check "
"again."
msgstr "A credencial foi recusada ou expirou. Abra %s para que ela possa renová-la e consulte novamente."

#: lib/prefs/accountText.js:15
msgid "The credential source for %s is unavailable or locked."
msgstr "A fonte de credenciais de %s está indisponível ou bloqueada."

#: lib/prefs/accountText.js:16
msgid "The provider reply changed. The external credential was not modified."
msgstr "A resposta do provedor mudou. A credencial externa não foi alterada."

#: lib/prefs/accountText.js:17
msgid "Could not check quota. The credential was not modified."
msgstr "Não foi possível consultar a cota. A credencial não foi alterada."

#: lib/prefs/accountText.js:18
msgid ""
"Using credentials from %s in read-only mode. The tool must renew its own "
"token."
msgstr "Usando as credenciais de %s em modo somente leitura. A ferramenta deve renovar o próprio token."

#: lib/prefs/accountText.js:32
msgid "Finish signing in using your browser. %d:%02d left."
msgstr "Conclua o login no navegador. Restam %d:%02d."

#: lib/prefs/accountText.js:35 lib/prefs/apiKeyController.js:153
msgid ""
"No keyring found. Unlock it in Passwords and Keys, or install a Secret "
"Service provider."
msgstr "Nenhum chaveiro encontrado. Desbloqueie-o em Senhas e Chaves ou instale um provedor de Secret Service."

#: lib/prefs/accountText.js:40
msgid "Not connected."
msgstr "Não conectado."

#: lib/prefs/accountText.js:42
msgid "The local configuration cannot be used: %s"
msgstr "A configuração local não pode ser usada: %s"

#: lib/prefs/accountText.js:43
msgid ""
"%s is not set up yet. Choose \"Find configuration automatically\" or copy "
"the helper command."
msgstr "%s ainda não está configurado. Escolha \"Buscar configuração automaticamente\" ou copie o comando auxiliar."

#: lib/prefs/accountText.js:46
msgid "Connected."
msgstr "Conectado."

#: lib/prefs/accountText.js:47
msgid "The sign-in expired. Reconnect to keep seeing this quota."
msgstr "O login expirou. Reconecte para continuar vendo esta cota."

#: lib/prefs/accountText.js:48
msgid "The provider refused access. Check your account on its site."
msgstr "O provedor recusou o acesso. Veja sua conta no site dele."

#: lib/prefs/accountText.js:49
msgid "Connected. The keyring is locked, so it was not checked."
msgstr "Conectado. O chaveiro está bloqueado, então não foi verificado."

#: lib/prefs/accountText.js:50
msgid "Connected. Could not reach the server."
msgstr "Conectado. Não foi possível falar com o servidor."

#: lib/prefs/accountText.js:51
msgid "Connected. The service replied in an unexpected way."
msgstr "Conectado. O serviço respondeu de forma inesperada."

#: lib/prefs/accountText.js:52
msgid "Connected, but the client id is missing from the local configuration."
msgstr "Conectado, mas falta o client id na configuração local."

#: lib/prefs/accountText.js:53
msgid "Connected. Not checked yet."
msgstr "Conectado, ainda não verificado."

#: lib/prefs/accounts.js:37
