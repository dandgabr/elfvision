msgid "Cancel"
msgstr "Cancelar"

#: lib/prefs/about.js:74
msgid "Restore"
msgstr "Restaurar"

#: lib/prefs/about.js:82
msgid "Defaults restored"
msgstr "Padrões restaurados"

#: lib/prefs/accountText.js:14 lib/prefs/apiKeyController.js:141
#: lib/prefs/oauthController.js:384 lib/prefs/oauthGroup.js:85
msgid "Account changes are blocked while local disconnection is incomplete."
msgstr "As alterações de contas ficam bloqueadas enquanto a desconexão local não for concluída."

#: lib/prefs/accountText.js:17
msgid "Finish signing in using your browser. %d:%02d left."
msgstr "Conclua o login no navegador. Restam %d:%02d."

#: lib/prefs/accountText.js:20 lib/prefs/apiKeyController.js:145
msgid ""
"No keyring found. Unlock it in Passwords and Keys, or install a Secret "
"Service provider."
msgstr "Nenhum chaveiro encontrado. Desbloqueie-o em Senhas e Chaves ou instale um provedor de Secret Service."

#: lib/prefs/accountText.js:25
msgid "Not connected."
msgstr "Não conectado."

#: lib/prefs/accountText.js:27
msgid "The local configuration cannot be used: %s"
msgstr "A configuração local não pode ser usada: %s"

#: lib/prefs/accountText.js:28
msgid ""
"%s is not set up yet. Press \"Copy command\", run it in a terminal, then "
"come back."
msgstr "O %s ainda não foi configurado. Toque em \"Copiar comando\", rode-o num terminal e volte aqui."

#: lib/prefs/accountText.js:31
msgid "Connected."
msgstr "Conectado."

#: lib/prefs/accountText.js:32
msgid "The sign-in expired. Reconnect to keep seeing this quota."
msgstr "O login expirou. Reconecte para continuar vendo esta cota."

#: lib/prefs/accountText.js:33
msgid "The provider refused access. Check your account on its site."
msgstr "O provedor recusou o acesso. Veja sua conta no site dele."

#: lib/prefs/accountText.js:34
msgid "Connected. The keyring is locked, so it was not checked."
msgstr "Conectado. O chaveiro está bloqueado, então não foi verificado."

#: lib/prefs/accountText.js:35
msgid "Connected. Could not reach the server."
msgstr "Conectado. Não foi possível falar com o servidor."

#: lib/prefs/accountText.js:36
msgid "Connected. The service replied in an unexpected way."
msgstr "Conectado. O serviço respondeu de forma inesperada."

#: lib/prefs/accountText.js:37
msgid "Connected, but the client id is missing from the local configuration."
msgstr "Conectado, mas falta o client id na configuração local."

#: lib/prefs/accountText.js:38
msgid "Connected. Not checked yet."
msgstr "Conectado, ainda não verificado."

#: lib/prefs/accounts.js:36
msgid "Accounts"
msgstr "Contas"

#: lib/prefs/accounts.js:43
msgid ""
"Create separate connectors for each account, including more than one account "
"with the same provider."
msgstr "Crie um conector separado para cada conta, inclusive para várias contas do mesmo provedor."

#: lib/prefs/accounts.js:44 lib/prefs/accounts.js:210 lib/prefs/accounts.js:222
msgid "Add connector"
msgstr "Adicionar conector"

#: lib/prefs/accounts.js:44
msgid "Command Code, Codex, Claude or Antigravity"
msgstr "Command Code, Codex, Claude ou Antigravity"

#: lib/prefs/accounts.js:45
msgid "Add connector…"
msgstr "Adicionar conector…"

#: lib/prefs/accounts.js:48
msgid "Demo connectors"
msgstr "Conectores de demonstração"

#: lib/prefs/accounts.js:48
msgid ""
"Fictional accounts. Connect and remove are simulated; no browser, keyring or "
"provider request is used."
msgstr "Contas fictícias. A conexão e a remoção são simuladas, sem usar o navegador ou o chaveiro nem enviar solicitações ao provedor."

#: lib/prefs/accounts.js:50 lib/ui/indicator.js:492
msgid "Connector configuration is unavailable"
msgstr "A configuração dos conectores está indisponível"

#: lib/prefs/accounts.js:50
msgid ""
"The local connector list is invalid. Saved credentials have not been changed."
msgstr "A lista local de conectores é inválida. As credenciais salvas não foram alteradas."

#: lib/prefs/accounts.js:51
msgid ""
"Rebuild the list from saved credential identities. Credentials are kept; "
"connector names may need to be entered again."
msgstr "Recrie a lista a partir dos identificadores das credenciais salvas. As credenciais são mantidas; pode ser necessário informar novamente os nomes dos conectores."

#: lib/prefs/accounts.js:51
msgid "Recover connector list"
msgstr "Recuperar lista de conectores"

#: lib/prefs/accounts.js:52
msgid "Recover list…"
msgstr "Recuperar lista…"

#: lib/prefs/accounts.js:59
msgid "Recover the connector list?"
msgstr "Recuperar a lista de conectores?"

#: lib/prefs/accounts.js:60
msgid ""
"Rebuild the fictional connector list. No real credential is read or changed. "
"Connector names may need to be entered again."
msgstr "Recrie a lista de conectores fictícios. Nenhuma credencial real é lida ou alterada. Pode ser necessário informar novamente os nomes dos conectores."

#: lib/prefs/accounts.js:61
msgid ""
"Read saved credential identities to rebuild the connector list. Secret "
"values are not read or deleted. Connector names and usernames may need to be "
"entered again."
msgstr "Leia os identificadores das credenciais salvas para recriar a lista de conectores. O conteúdo das credenciais não é lido nem excluído. Pode ser necessário informar novamente os nomes dos conectores e de usuário."

#: lib/prefs/accounts.js:62
msgid "Recover list"
msgstr "Recuperar lista"

#: lib/prefs/accounts.js:71
msgid ""
"The connector list could not be recovered. Saved credentials were kept. "
"Unlock the keyring and retry."
msgstr "Não foi possível recuperar a lista de conectores. As credenciais salvas foram mantidas. Desbloqueie o chaveiro e tente novamente."

#: lib/prefs/accounts.js:80
msgid "Add a connector to start tracking an account."
msgstr "Adicione um conector para começar a acompanhar uma conta."

#: lib/prefs/accounts.js:80
msgid "No connectors"
msgstr "Nenhum conector"

#: lib/prefs/accounts.js:83
msgid ""
"Reset appearance, notifications and tracking. Saved connectors and "
"credentials stay saved."
msgstr "Restaure a aparência, as notificações e o acompanhamento. Os conectores e as credenciais salvos são mantidos."

#: lib/prefs/accounts.js:83
msgid "Restore default settings"
msgstr "Restaurar configurações padrão"

#: lib/prefs/accounts.js:106
msgid "Paused"
msgstr "Pausado"

#: lib/prefs/accounts.js:107 lib/prefs/accounts.js:295
msgid "Demo connected"
msgstr "Conectado na demonstração"

#: lib/prefs/accounts.js:107 lib/prefs/accounts.js:295
msgid "Demo not connected"
msgstr "Não conectado na demonstração"

#: lib/prefs/accounts.js:132 lib/prefs/accounts.js:133
msgid "Configure %s"
msgstr "Configurar %s"

#: lib/prefs/accounts.js:210
msgid ""
"Choose a provider and a name that helps you distinguish this account. "
"Creating a connector does not sign in."
msgstr "Escolha um provedor e um nome que ajude a distinguir esta conta. Criar um conector não inicia uma sessão."

#: lib/prefs/accounts.js:213
msgid "Provider"
msgstr "Provedor"

#: lib/prefs/accounts.js:214 lib/prefs/accounts.js:240
msgid "Connector name"
msgstr "Nome do conector"

#: lib/prefs/accounts.js:229
msgid ""
"The connector could not be created. Check the name and the number of "
"connectors."
msgstr "Não foi possível criar o conector. Verifique o nome e a quantidade de conectores."

#: lib/prefs/accounts.js:243
msgid "Enter a valid connector name."
msgstr "Informe um nome válido para o conector."

#: lib/prefs/accounts.js:252
msgid ""
"Delete this connector and its local credential. Other accounts are kept."
msgstr "Exclua este conector e a credencial local correspondente. As outras contas são mantidas."

#: lib/prefs/accounts.js:252 lib/prefs/accounts.js:257
msgid "Remove connector"
msgstr "Remover conector"

#: lib/prefs/accounts.js:253
msgid "Remove…"
msgstr "Remover…"

#: lib/prefs/accounts.js:255
msgid "Remove %s?"
msgstr "Remover %s?"

#: lib/prefs/accounts.js:256
msgid ""
"Its local credential and quota data are removed. Access may remain valid on "
"the provider’s site. Other connectors are kept."
msgstr "A credencial local e os dados de cota deste conector são removidos. O acesso pode continuar válido no site do provedor. Os outros conectores são mantidos."

#: lib/prefs/accounts.js:256
msgid ""
"This removes only this fictional connector. No real credential is changed."
msgstr "Esta ação remove apenas este conector fictício. Nenhuma credencial real é alterada."

#: lib/prefs/accounts.js:266
msgid ""
"The credential was removed, but the connector list could not be updated. "
"Retry removing the connector."
msgstr "A credencial foi removida, mas não foi possível atualizar a lista de conectores. Tente remover o conector novamente."

#: lib/prefs/accounts.js:268
