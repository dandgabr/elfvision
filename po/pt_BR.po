#: lib/prefs/about.js:34
msgid "About"
msgstr "Sobre"

#: lib/prefs/about.js:38
msgid "Elfvision"
msgstr "Elfvision"

#: lib/prefs/about.js:43
msgid ""
"Monitors AI quotas, reset times and API spending. This build integrates with "
"GNOME Shell."
msgstr "Monitora cotas de IA, prazos de reinício e gastos com APIs. Esta versão integra-se ao GNOME Shell."

#: lib/prefs/about.js:49
msgid "Created by"
msgstr "Criado por"

#: lib/prefs/about.js:50
msgid "Daniel G. Araujo on GitHub"
msgstr "Daniel G. Araujo no GitHub"

#: lib/prefs/about.js:56
msgid "Opens a public GitHub issue form. Review anything you share."
msgstr "Abre um formulário público no GitHub. Revise tudo que compartilhar."

#: lib/prefs/about.js:56
msgid "Report a bug"
msgstr "Relatar um bug"

#: lib/prefs/about.js:57
msgid ""
"Opens a private GitHub security report. Do not report vulnerabilities in "
"public issues."
msgstr "Abre um relato privado de segurança no GitHub. Não relate vulnerabilidades em issues públicas."

#: lib/prefs/about.js:57
msgid "Report a vulnerability"
msgstr "Relatar uma vulnerabilidade"

#: lib/prefs/about.js:66
msgid "Could not open the report page"
msgstr "Não foi possível abrir a página de relato"

#: lib/prefs/about.js:72
msgid "Choose providers and review the bar and notifications."
msgstr "Escolha provedores e confira a barra e as notificações."

#: lib/prefs/about.js:72
msgid "Set up again"
msgstr "Configurar novamente"

#: lib/prefs/about.js:78
msgid "Restore configuration"
msgstr "Restaurar configurações"

#: lib/prefs/about.js:79
msgid ""
"Appearance, top bar, popup and notifications. Saved connectors and "
"credentials stay saved. Tracking returns to its default."
msgstr "Aparência, barra superior, painel e notificações. Os conectores e as credenciais salvos são mantidos. O acompanhamento volta ao padrão."

#: lib/prefs/about.js:82
msgid "Restore…"
msgstr "Restaurar…"

#: lib/prefs/about.js:91
msgid "Restore the default settings?"
msgstr "Restaurar as configurações padrão?"

#: lib/prefs/about.js:92
msgid ""
"Appearance, theme, top bar, popup and notification settings go back to their "
"defaults. Saved connectors, credentials and client configuration are kept. "
"All connectors are tracked again and setup becomes available. Your data "
"source stays the same."
msgstr "A aparência, o tema, a barra superior, o painel e as notificações voltam às configurações padrão. Os conectores, as credenciais e a configuração de cliente salvos são mantidos. Todos os conectores voltam a ser acompanhados e a configuração inicial fica disponível. A fonte de dados permanece a mesma."

