# Dependencies and build output
node_modules/
dist/
build/
*.zip
*.shell-extension.zip

# Generated files (rebuilt by tools/ and the packaging step)
schemas/gschemas.compiled
locale/
*.mo
themes/generated/
__pycache__/
*.pyc

# Secrets and local configuration. Never commit provider credentials,
# OAuth client ids, API keys or tokens. Real values belong in
# ~/.config/gnome-ai-quota/, never in the working tree.
*.local.json
providers.json
credentials*.json
auth.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Caches, logs and coverage
.cache/
coverage/
*.log

# Editors and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
