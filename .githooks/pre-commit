#!/usr/bin/env bash
# Stops a commit that carries a secret. Enable it once per clone:
#   git config core.hooksPath .githooks
#
# The built-in check always runs and needs only git and Python. gitleaks, when installed,
# runs as well with the rules in .gitleaks.toml.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

python3 -I tools/check-secrets.py

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner --config .gitleaks.toml 2>/dev/null \
        || gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
fi
